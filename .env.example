# Public URL for this Daymark instance. Use HTTPS in production.
BASE_URL=http://localhost:4173
PORT=4173
HOST=127.0.0.1
# Required for an internet-hosted personal instance. This protects Daymark itself;
# use a new random password here, never your Google or Blackbaud password.
DAYMARK_USERNAME=daymark
DAYMARK_PASSWORD=

# Production state bridge. The key must be at least 32 random characters and
# must match the sensitive DAYMARK_SYNC_KEY configured in Vercel.
DAYMARK_CLOUD_URL=https://your-daymark-project.vercel.app
DAYMARK_SYNC_KEY=
DAYMARK_AUTO_SYNC_MINUTES=15
